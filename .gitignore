# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
/e2e/test-output/

# Node
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular CLI and build artefacts
/.angular/
/.angular-cli.json
/.ng/
*.tsbuildinfo

# Environment files
/.env

# Claude Code — machine-local approvals; launch.json IS tracked (shared dev-server config)
.claude/settings.local.json

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Miscellaneous
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db
